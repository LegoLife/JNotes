@implements IAsyncDisposable
@inject IJSRuntime JS
@inject INoteStore Store
@inject NoteFactory Factory
@inject ITrash Trash
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<div class="tree-toolbar">
    <MudText Typo="Typo.overline">Notes</MudText>
    <MudSpacer />
    <MudTooltip Text="New note">
        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.NoteAdd" OnClick="() => NewNoteAsync(null)" aria-label="New note" />
    </MudTooltip>
    <MudTooltip Text="New note from template">
        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.PostAdd" OnClick="() => NewNoteFromTemplateAsync(null, null)" aria-label="New note from template" />
    </MudTooltip>
    <MudTooltip Text="New folder">
        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.CreateNewFolder" OnClick="() => NewFolderAsync(null)" aria-label="New folder" />
    </MudTooltip>
    <MudTooltip Text="Trash">
        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Delete" Href="trash" aria-label="Trash" />
    </MudTooltip>
</div>

@* Raw ondragstart sets dataTransfer (required by Firefox to start a drag). tree-dnd.js shows the drop
   position and reports drops to DropAt; Blazor tracks the dragged item and opens folders on hover. *@
<nav @ref="_nav" class="tree @(_dragging is not null && _dropTarget == RootTarget ? "drop-root" : null)" aria-label="Notes"
     ondragstart="event.dataTransfer.setData('text/plain','jnotes');event.dataTransfer.effectAllowed='move'"
     @ondragenter="() => SetDropTarget(RootTarget)">
    @if (_index.IsEmpty)
    {
        <MudText Typo="Typo.body2" Class="tree-empty">No notes yet. Create a folder or a note to get started.</MudText>
    }
    @RenderLevel(null, 0)
</nav>

@code {
    private NoteTreeIndex _index = new([]);
    private readonly HashSet<Guid> _expanded = [];
    private Guid? _activeId;

    protected override async Task OnInitializedAsync()
    {
        Store.TreeChanged += OnTreeChanged;
        Nav.LocationChanged += OnLocationChanged;
        await ReloadAsync();
        SetActiveFromUrl(Nav.Uri);
    }

    private async Task ReloadAsync() => _index = new NoteTreeIndex(await Store.GetTreeAsync());

    // Coalesce bursts (e.g. an import creating hundreds of notes) into one reload.
    private bool _reloadPending;

    private void OnTreeChanged()
    {
        if (_reloadPending) return;
        _reloadPending = true;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(150);
            _reloadPending = false;
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(() =>
    {
        SetActiveFromUrl(e.Location);
        StateHasChanged();
    });

    private void SetActiveFromUrl(string uri)
    {
        var rel = Nav.ToBaseRelativePath(uri);
        _activeId = rel.StartsWith("notes/") && Guid.TryParse(rel.AsSpan(6, Math.Min(36, rel.Length - 6)), out var id) ? id : null;
        if (_activeId is { } active)
            foreach (var a in _index.AncestorsOf(active)) _expanded.Add(a.Id);
    }

    private RenderFragment RenderLevel(Guid? parentId, int depth) => __builder =>
    {
        var siblings = _index.ChildrenOf(parentId);
        for (var i = 0; i < siblings.Count; i++)
        {
            var e = siblings[i];
            var (first, last) = (i == 0, i == siblings.Count - 1);
            var indent = $"padding-left:{depth * 14 + 4}px";
            var dragClass = _dragging?.Id == e.Id ? "dragging" : null;
            var noDrop = _dragging is not null && _noDrop.Contains(e.Id);
            if (e.IsFolder)
            {
                var open = _expanded.Contains(e.Id);
                <div class="tree-row @dragClass" style="@indent" draggable="true"
                     data-id="@e.Id" data-folder data-open="@open" data-nodrop="@noDrop"
                     @ondragstart="() => StartDrag(e)" @ondragend="EndDrag"
                     @ondragenter="() => SetDropTarget(e.Id)" @ondragenter:stopPropagation="true">
                    <button class="tree-label" @onclick="() => Toggle(e.Id)" aria-expanded="@(open ? "true" : "false")">
                        <MudIcon Icon="@(open ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small" />
                        <MudIcon Icon="@(open ? Icons.Material.Outlined.FolderOpen : Icons.Material.Outlined.Folder)" Size="Size.Small" />
                        <span class="tree-name">@e.Name</span>
                    </button>
                    <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" Dense="true" Class="tree-menu" aria-label="@($"Actions for {e.Name}")">
                        <MudMenuItem Icon="@Icons.Material.Outlined.NoteAdd" OnClick="() => Later(() => NewNoteAsync(e.Id))">New note here</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.PostAdd" OnClick="() => Later(() => NewNoteFromTemplateAsync(e.Id, null))">New note from template…</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.CreateNewFolder" OnClick="() => Later(() => NewFolderAsync(e.Id))">New subfolder</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.DashboardCustomize" OnClick="() => Later(() => SetDefaultTemplateAsync(e))">Default template…</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="() => Later(() => RenameAsync(e))">Rename</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.DriveFileMove" OnClick="() => Later(() => MoveAsync(e))">Move</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.ArrowUpward" Disabled="first" OnClick="() => ShiftAsync(e, -1)">Move up</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.ArrowDownward" Disabled="last" OnClick="() => ShiftAsync(e, 1)">Move down</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.Delete" OnClick="() => Later(() => DeleteAsync(e))">Delete</MudMenuItem>
                    </MudMenu>
                </div>
                @if (open)
                {
                    @RenderLevel(e.Id, depth + 1)
                }
            }
            else
            {
                @* Dropping onto a note places the dragged item just above or below it. *@
                <div class="tree-row @(e.Id == _activeId ? "active" : null) @dragClass" style="@indent" draggable="true"
                     data-id="@e.Id" data-nodrop="@noDrop"
                     @ondragstart="() => StartDrag(e)" @ondragend="EndDrag"
                     @ondragenter="() => SetDropTarget(e.Id)" @ondragenter:stopPropagation="true">
                    <a class="tree-label" href="@($"notes/{e.Id}")" draggable="false">
                        <span class="tree-spacer"></span>
                        <MudIcon Icon="@Icons.Material.Outlined.Description" Size="Size.Small" />
                        <span class="tree-name">@e.Name</span>
                    </a>
                    <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" Dense="true" Class="tree-menu" aria-label="@($"Actions for {e.Name}")">
                        <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="() => Later(() => RenameAsync(e))">Rename</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.DriveFileMove" OnClick="() => Later(() => MoveAsync(e))">Move</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.ArrowUpward" Disabled="first" OnClick="() => ShiftAsync(e, -1)">Move up</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.ArrowDownward" Disabled="last" OnClick="() => ShiftAsync(e, 1)">Move down</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.Delete" OnClick="() => Later(() => DeleteAsync(e))">Delete</MudMenuItem>
                    </MudMenu>
                </div>
            }
        }
    };

    private void Toggle(Guid id)
    {
        if (!_expanded.Remove(id)) _expanded.Add(id);
    }

    /// <summary>Quick "Untitled" note — unless the folder has a default template, then ask for a title.</summary>
    private async Task NewNoteAsync(Guid? folderId)
    {
        if (folderId is { } fid && await Store.GetFolderAsync(fid) is { DefaultTemplateId: { } templateId })
        {
            await NewNoteFromTemplateAsync(fid, templateId);
            return;
        }
        await RunAsync(async () =>
        {
            var note = await Store.CreateNoteAsync("Untitled", folderId);
            if (folderId is { } f) _expanded.Add(f);
            Nav.NavigateTo($"notes/{note.Id}");
        });
    }

    private async Task NewNoteFromTemplateAsync(Guid? folderId, Guid? templateId)
    {
        var folder = folderId is { } fid ? await Store.GetFolderAsync(fid) : null;
        var dialog = await Dialogs.ShowAsync<NewNoteDialog>(null, new DialogParameters<NewNoteDialog>
        {
            { x => x.FolderName, folder?.Name },
            { x => x.DefaultTemplateId, templateId ?? folder?.DefaultTemplateId },
        }, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        if (await dialog.Result is not { Canceled: false, Data: NewNoteDialog.Result request }) return;

        await RunAsync(async () =>
        {
            var note = await Factory.CreateAsync(request.Title, folderId, request.TemplateId);
            if (folderId is { } f) _expanded.Add(f);
            Nav.NavigateTo($"notes/{note.Id}");
        });
    }

    private async Task SetDefaultTemplateAsync(TreeEntry folder)
    {
        var current = (await Store.GetFolderAsync(folder.Id))?.DefaultTemplateId;
        var dialog = await Dialogs.ShowAsync<DefaultTemplateDialog>(null, new DialogParameters<DefaultTemplateDialog>
        {
            { x => x.FolderName, folder.Name }, { x => x.CurrentTemplateId, current },
        }, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        if (await dialog.Result is not { Canceled: false, Data: Guid chosen }) return;

        await RunAsync(async () =>
        {
            await Store.SetDefaultTemplateAsync(folder.Id, chosen == Guid.Empty ? null : chosen);
            Snackbar.Add(chosen == Guid.Empty ? $"“{folder.Name}” has no default template." : $"Default template set for “{folder.Name}”.", Severity.Success);
        });
    }

    private async Task NewFolderAsync(Guid? parentId)
    {
        var name = await PromptAsync("New folder", "Folder name", "", "Create");
        if (name is null) return;
        await RunAsync(async () =>
        {
            var folder = await Store.CreateFolderAsync(name, parentId);
            if (parentId is { } p) _expanded.Add(p);
            _expanded.Add(folder.Id);
        });
    }

    private async Task RenameAsync(TreeEntry e)
    {
        var name = await PromptAsync(e.IsFolder ? "Rename folder" : "Rename note", "Name", e.Name, "Rename");
        if (name is null || name == e.Name) return;
        await RunAsync(() => e.IsFolder ? Store.RenameFolderAsync(e.Id, name) : Store.RenameNoteAsync(e.Id, name));
    }

    private async Task MoveAsync(TreeEntry e)
    {
        var dialog = await Dialogs.ShowAsync<MoveDialog>(null, new DialogParameters<MoveDialog>
        {
            { x => x.ItemName, e.Name },
            { x => x.Destinations, _index.MoveDestinationsFor(e) },
            { x => x.CurrentParentId, e.ParentId },
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: Guid target }) return;
        await MoveToAsync(e, target == Guid.Empty ? null : target);
    }

    // ---------- Ordering and drag and drop ----------
    private ElementReference _nav;
    private IJSObjectReference? _dndModule, _dnd;
    private DotNetObjectReference<NoteTree>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        _dndModule = await JS.InvokeAsync<IJSObjectReference>("import", "./tree-dnd.js");
        _dnd = await _dndModule.InvokeAsync<IJSObjectReference>("init", _nav, _self);
    }

    /// <summary>Swaps an item with its neighbour above (-1) or below (+1).</summary>
    private async Task ShiftAsync(TreeEntry e, int delta)
    {
        var order = _index.ChildrenOf(e.ParentId).Select(c => c.Id).ToList();
        var i = order.IndexOf(e.Id);
        var j = i + delta;
        if (i < 0 || j < 0 || j >= order.Count) return;
        (order[i], order[j]) = (order[j], order[i]);
        await RunAsync(() => Store.ReorderAsync(e.ParentId, order));
    }

    // _dropTarget: entry being hovered (folders open after a moment), RootTarget for empty space, null for none.
    private static readonly Guid RootTarget = Guid.Empty;
    private TreeEntry? _dragging;
    private HashSet<Guid> _noDrop = [];
    private Guid? _dropTarget;

    /// <summary>The item itself and everything inside it: nothing can be dropped onto those.</summary>
    private HashSet<Guid> SelfAndInside(TreeEntry e) =>
        e.IsFolder ? _index.DescendantsOf(e.Id).Select(d => d.Id).Append(e.Id).ToHashSet() : [e.Id];

    private void StartDrag(TreeEntry e)
    {
        _dragging = e;
        _noDrop = SelfAndInside(e);
        _dropTarget = null;
    }

    private void EndDrag()
    {
        _dragging = null;
        _dropTarget = null;
    }

    private async Task SetDropTarget(Guid target)
    {
        if (_dragging is null || _dropTarget == target) return;
        _dropTarget = target;

        // Hovering a collapsed folder for a moment opens it, so deep folders are reachable.
        if (_index.Find(target) is { IsFolder: true } && !_expanded.Contains(target) && !_noDrop.Contains(target))
        {
            await Task.Delay(700);
            if (_dragging is not null && _dropTarget == target) _expanded.Add(target);
        }
    }

    /// <summary>Called by tree-dnd.js. zone: "before" / "after" / "into" the target row, or "root" for empty space.</summary>
    [JSInvokable]
    public async Task DropAt(string dragId, string? targetId, string zone)
    {
        EndDrag();
        if (!Guid.TryParse(dragId, out var id) || _index.Find(id) is not { } item) return;
        var target = Guid.TryParse(targetId, out var t) ? _index.Find(t) : null;

        if (zone == "root") await MoveToAsync(item, null);
        else if (target is null || SelfAndInside(item).Contains(target.Id)) { }
        else if (zone == "into" && target.IsFolder) await MoveToAsync(item, target.Id);
        else if (zone is "before" or "after") await PlaceNextToAsync(item, target, zone == "after");
        StateHasChanged();
    }

    private async Task PlaceNextToAsync(TreeEntry item, TreeEntry target, bool after)
    {
        var parent = target.ParentId;
        var order = _index.ChildrenOf(parent).Where(c => c.Id != item.Id).Select(c => c.Id).ToList();
        order.Insert(order.IndexOf(target.Id) + (after ? 1 : 0), item.Id);
        await RunAsync(async () =>
        {
            if (item.ParentId != parent)
            {
                if (item.IsFolder) await Store.MoveFolderAsync(item.Id, parent);
                else await Store.MoveNoteAsync(item.Id, parent);
            }
            await Store.ReorderAsync(parent, order);
        });
    }

    private async Task MoveToAsync(TreeEntry e, Guid? destination)
    {
        if (destination == e.ParentId) return;
        await RunAsync(async () =>
        {
            if (e.IsFolder) await Store.MoveFolderAsync(e.Id, destination);
            else await Store.MoveNoteAsync(e.Id, destination);
            if (destination is { } d)
            {
                _expanded.Add(d);
                foreach (var a in _index.AncestorsOf(d)) _expanded.Add(a.Id);
            }
        });
    }

    // Deleting moves to Trash (kept 30 days), so no confirmation: just an Undo button.
    private async Task DeleteAsync(TreeEntry e)
    {
        var removedNotes = e.IsFolder
            ? _index.DescendantsOf(e.Id).Where(d => !d.IsFolder).Select(d => d.Id).ToHashSet()
            : [e.Id];

        await RunAsync(async () =>
        {
            var batch = e.IsFolder ? await Store.DeleteFolderAsync(e.Id) : await Store.DeleteNoteAsync(e.Id);
            if (_activeId is { } active && removedNotes.Contains(active)) Nav.NavigateTo("");
            Snackbar.Add($"Moved “{e.Name}” to Trash", Severity.Normal, config =>
            {
                config.Action = "Undo";
                config.ActionColor = Color.Primary;
                config.OnClick = _ => InvokeAsync(() => RunAsync(() => Trash.RestoreAsync(batch)));
            });
        });
    }

    private async Task<string?> PromptAsync(string title, string label, string value, string confirm)
    {
        var dialog = await Dialogs.ShowAsync<NameDialog>(null, new DialogParameters<NameDialog>
        {
            { x => x.Title, title }, { x => x.Label, label }, { x => x.Value, value }, { x => x.ConfirmText, confirm },
        }, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        return result is { Canceled: false, Data: string s } ? s : null;
    }

    /// <summary>
    /// MudMenu stays open until its item's OnClick task completes, so menu actions that open a
    /// dialog would leave the menu (and its focus trap) up behind the dialog. Start them detached.
    /// </summary>
    private Task Later(Func<Task> action)
    {
        _ = InvokeAsync(action);
        return Task.CompletedTask;
    }

    private async Task RunAsync(Func<Task> action)
    {
        try { await action(); }
        catch (DomainException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
    }

    public async ValueTask DisposeAsync()
    {
        Store.TreeChanged -= OnTreeChanged;
        Nav.LocationChanged -= OnLocationChanged;
        try
        {
            if (_dnd is not null) { await _dnd.InvokeVoidAsync("dispose"); await _dnd.DisposeAsync(); }
            if (_dndModule is not null) await _dndModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}
