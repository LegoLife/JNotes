<MudDialog>
    <TitleContent>@Title</TitleContent>
    <DialogContent>
        <MudTextField @ref="_input" @bind-Value="Value" Label="@Label" AutoFocus="true" Immediate="true"
                      OnKeyDown="OnKeyDown" MaxLength="MaxLength" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="string.IsNullOrWhiteSpace(Value)"
                   OnClick="Submit">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Title { get; set; } = "Name";
    [Parameter] public string Label { get; set; } = "Name";
    [Parameter] public string ConfirmText { get; set; } = "Save";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public int MaxLength { get; set; } = 200;

    private MudTextField<string>? _input;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _input is not null) await _input.SelectAsync(); // focus + select existing name
    }

    private void Submit()
    {
        if (!string.IsNullOrWhiteSpace(Value)) MudDialog.Close(DialogResult.Ok(Value.Trim()));
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Submit();
    }
}
