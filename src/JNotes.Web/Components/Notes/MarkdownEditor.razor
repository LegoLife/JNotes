@implements IAsyncDisposable
@inject IJSRuntime JS
@inject INoteStore Store
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

@* mousedown is suppressed so toolbar clicks don't steal focus/selection from the editor. *@
<div class="editor-toolbar" role="toolbar" aria-label="Formatting" @onmousedown:preventDefault="true">
    @foreach (var group in ToolbarGroups)
    {
        <div class="tb-group">
            @foreach (var (command, icon, label) in group)
            {
                <MudTooltip Text="@label" Delay="500">
                    <MudIconButton Size="Size.Small" Icon="@icon" aria-label="@label" OnClick="() => ExecAsync(command)" />
                </MudTooltip>
            }
        </div>
    }
    <div class="tb-group">
        <MudTooltip Text="Insert/edit link (Ctrl+L)" Delay="500">
            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Link" aria-label="Insert link" OnClick="InsertLinkAsync" />
        </MudTooltip>
        <MudTooltip Text="Remove link" Delay="500">
            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.LinkOff" aria-label="Remove link" OnClick="@(() => ExecAsync("unlink"))" />
        </MudTooltip>
        <MudTooltip Text="Insert image" Delay="500">
            <label class="tb-file mud-icon-button" aria-label="Insert image">
                <input type="file" accept="image/png,image/jpeg,image/gif,image/webp" multiple hidden @ref="_fileInput" />
                <MudIcon Icon="@Icons.Material.Outlined.Image" Size="Size.Small" />
            </label>
        </MudTooltip>
        <MudTooltip Text="Embed YouTube video" Delay="500">
            <MudIconButton Size="Size.Small" Icon="@Icons.Custom.Brands.YouTube" aria-label="Embed YouTube video" OnClick="InsertYouTubeAsync" />
        </MudTooltip>
    </div>
</div>

<div class="editor-host" @ref="_host"></div>

@code {
    /// <summary>Initial markdown. Only read when the editor is created; re-key the component to load a different document.</summary>
    [Parameter, EditorRequired] public string Markdown { get; set; } = "";

    /// <summary>Called (debounced) with the full markdown whenever the user edits.</summary>
    [Parameter, EditorRequired] public Func<string, Task> SaveAsync { get; set; } = default!;

    /// <summary>Called with a request id when Enter is pressed in a ✨ box. Null = generation not offered (e.g. templates).</summary>
    [Parameter] public Func<string, Task>? GenerateAsync { get; set; }

    private static readonly (string Command, string Icon, string Label)[][] ToolbarGroups =
    [
        [
            ("bold", Icons.Material.Filled.FormatBold, "Bold (Ctrl+B)"),
            ("italic", Icons.Material.Filled.FormatItalic, "Italic (Ctrl+I)"),
            ("strike", Icons.Material.Filled.FormatStrikethrough, "Strikethrough"),
            ("code", Icons.Material.Filled.Code, "Inline code"),
        ],
        [
            ("h1", Icons.Material.Filled.LooksOne, "Heading 1"),
            ("h2", Icons.Material.Filled.LooksTwo, "Heading 2"),
            ("h3", Icons.Material.Filled.Looks3, "Heading 3"),
        ],
        [
            ("bulletList", Icons.Material.Filled.FormatListBulleted, "Bullet list"),
            ("orderedList", Icons.Material.Filled.FormatListNumbered, "Numbered list"),
            ("taskList", Icons.Material.Outlined.Checklist, "Checklist"),
            ("blockquote", Icons.Material.Filled.FormatQuote, "Quote"),
            ("codeBlock", Icons.Material.Outlined.DataObject, "Code block"),
            ("table", Icons.Material.Outlined.TableChart, "Table"),
            ("hr", Icons.Material.Filled.HorizontalRule, "Divider"),
        ],
        [
            ("aiRequest", Icons.Material.Outlined.AutoAwesome, "Ask Claude here (or type /ai)"),
        ],
        [
            ("undo", Icons.Material.Filled.Undo, "Undo (Ctrl+Z)"),
            ("redo", Icons.Material.Filled.Redo, "Redo (Ctrl+Shift+Z)"),
        ],
    ];

    private ElementReference _host;
    private ElementReference _fileInput;
    private IJSObjectReference? _module;
    private IJSObjectReference? _editor;
    private DotNetObjectReference<MarkdownEditor>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./" + Assets["js/editor.js"]);
        _editor = await _module.InvokeAsync<IJSObjectReference>("create", _host, _self, Markdown,
            new { debounceMs = 1000, fileInput = _fileInput, canGenerate = GenerateAsync is not null });
    }

    [JSInvokable]
    public Task OnGenerate(string requestId) => GenerateAsync?.Invoke(requestId) ?? Task.CompletedTask;

    public async Task SetRequestStatusAsync(string requestId, string? status)
    {
        if (_editor is not null) await _editor.InvokeAsync<bool>("setRequestStatus", requestId, status);
    }

    public sealed record NoteMatch(Guid Id, string Title, string Path);

    /// <summary>Notes for the [[ link picker: recent notes for an empty query, else ranked title matches.</summary>
    [JSInvokable]
    public async Task<List<NoteMatch>> FindNotes(string query)
    {
        var tree = await Store.GetTreeAsync();
        var index = new NoteTreeIndex(tree);
        string PathOf(Guid? f) => f is { } id && index.Find(id) is not null ? index.PathOf(id) : "";
        var q = query.Trim();
        if (q.Length == 0)
            return (await Store.GetRecentNotesAsync(8)).Select(n => new NoteMatch(n.Id, n.Title, PathOf(n.FolderId))).ToList();
        return tree.Where(e => !e.IsFolder)
            .Select(e => (e, rank: QuickSwitcher.Rank(e.Name, q)))
            .Where(x => x.rank < 3)
            .OrderBy(x => x.rank).ThenBy(x => x.e.Name.Length).ThenBy(x => x.e.Name, StringComparer.CurrentCultureIgnoreCase)
            .Take(10).Select(x => new NoteMatch(x.e.Id, x.e.Name, PathOf(x.e.ParentId))).ToList();
    }

    [JSInvokable]
    public Task OnContentChanged(string markdown) => SaveAsync(markdown);

    [JSInvokable]
    public Task OnError(string message) => InvokeAsync(() => Snackbar.Add(message, Severity.Error));

    public async Task FocusAsync()
    {
        if (_editor is not null) await _editor.InvokeVoidAsync("focus");
    }

    /// <summary>Applies an edit Claude made on the server: a targeted patch if possible, else a full reload.</summary>
    public async Task ApplyEditAsync(NoteEdit edit)
    {
        if (_editor is null) return;
        var applied = edit switch
        {
            RequestFulfilledEdit f => await _editor.InvokeAsync<bool>("applyRemote", "fulfill", new { requestId = f.RequestId, block = f.ResultBlock }),
            AppendEdit a => await _editor.InvokeAsync<bool>("applyRemote", "append", new { markdown = a.Markdown }),
            SectionEdit s => await _editor.InvokeAsync<bool>("applyRemote", "section", new { heading = s.Heading, markdown = s.Markdown }),
            _ => false,
        };
        if (!applied) await _editor.InvokeVoidAsync("setMarkdown", edit.NewContent);
    }

    private async Task ExecAsync(string command)
    {
        if (_editor is not null) await _editor.InvokeAsync<bool>("exec", command, null);
    }

    [JSInvokable]
    public Task RequestLink() => InvokeAsync(InsertLinkAsync);

    private async Task InsertLinkAsync()
    {
        if (_editor is null) return;
        var current = await _editor.InvokeAsync<string>("exec", "getLink", null);
        var dialog = await Dialogs.ShowAsync<NameDialog>(null, new DialogParameters<NameDialog>
        {
            { x => x.Title, string.IsNullOrEmpty(current) ? "Insert link" : "Edit link" },
            { x => x.Label, "URL (e.g. https://example.com)" }, { x => x.ConfirmText, "Save" },
            { x => x.Value, current ?? "" }, { x => x.MaxLength, 2000 },
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is not { Canceled: false, Data: string url }) return;
        await _editor.InvokeAsync<bool>("exec", "link", url.Trim());
    }

    private async Task InsertYouTubeAsync()
    {
        if (_editor is null) return;
        var dialog = await Dialogs.ShowAsync<NameDialog>(null, new DialogParameters<NameDialog>
        {
            { x => x.Title, "Embed YouTube video" }, { x => x.Label, "YouTube link" }, { x => x.ConfirmText, "Embed" },
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is not { Canceled: false, Data: string url }) return;

        if (!await _editor.InvokeAsync<bool>("exec", "youtube", url.Trim()))
            Snackbar.Add("That doesn't look like a YouTube link.", Severity.Warning);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_editor is not null)
            {
                await _editor.InvokeVoidAsync("destroy"); // flushes any pending save first
                await _editor.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit is gone (tab closed); the visibilitychange flush already ran in the browser.
        }
        _self?.Dispose();
    }
}
