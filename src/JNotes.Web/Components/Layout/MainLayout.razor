@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IDialogService Dialogs
@inject JNotes.Data.BackupService Backups

<MudThemeProvider @ref="_themeProvider" Theme="_theme" @bind-IsDarkMode="_dark" />
<MudPopoverProvider />
@* FirstChild: dialogs focus their first input (the default focuses the dialog itself, so typing goes nowhere). *@
<MudDialogProvider CloseOnEscapeKey="true" DefaultFocus="DefaultFocus.FirstChild" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="app-bar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="() => _drawerOpen = !_drawerOpen" aria-label="Toggle sidebar" />
        <MudText Typo="Typo.h6" Class="ml-2">
            <a href="" class="brand">JNotes</a>
        </MudText>
        <button class="search-launcher" @onclick="OpenQuickSwitcher" aria-label="Find a note (Ctrl+K)">
            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
            <span>Find a note…</span>
            <kbd>Ctrl K</kbd>
        </button>
        <MudSpacer />
        <MudTooltip Text="Search all notes">
            <MudIconButton Href="search" Icon="@Icons.Material.Outlined.ManageSearch" Color="Color.Inherit" aria-label="Search all notes" />
        </MudTooltip>
        <MudTooltip Text="Claude">
            <MudIconButton Href="claude" Icon="@Icons.Material.Outlined.AutoAwesome" Color="Color.Inherit" aria-label="Claude" />
        </MudTooltip>
        <MudTooltip Text="Templates">
            <MudIconButton Href="templates" Icon="@Icons.Material.Outlined.DashboardCustomize" Color="Color.Inherit" aria-label="Templates" />
        </MudTooltip>
        <MudTooltip Text="Import from Docmost">
            <MudIconButton Href="import" Icon="@Icons.Material.Outlined.FileUpload" Color="Color.Inherit" aria-label="Import from Docmost" />
        </MudTooltip>
        <MudTooltip Text="@(_backupStale ? "Settings · backups need attention" : "Settings")">
            <MudBadge Dot="true" Color="Color.Warning" Visible="_backupStale" Overlap="true">
                <MudIconButton Href="settings" Icon="@Icons.Material.Outlined.Settings" Color="Color.Inherit" aria-label="Settings" />
            </MudBadge>
        </MudTooltip>
        <MudIconButton Icon="@(_dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="() => _dark = !_dark" aria-label="Toggle dark mode" />
        <form method="post" action="logout" data-enhance="false">
            <AntiforgeryToken />
            <MudIconButton ButtonType="ButtonType.Submit" Icon="@Icons.Material.Filled.Logout"
                           Color="Color.Inherit" aria-label="Sign out" />
        </form>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0"
               Variant="DrawerVariant.Responsive" Width="280px" Class="sidebar">
        <NoteTree />
    </MudDrawer>

    <MudMainContent>
        <div class="page">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private MudThemeProvider? _themeProvider;
    private bool _drawerOpen = true;
    private bool _dark;
    private bool _switcherOpen;
    private bool _backupStale;

    // Don't nag in the first hour after startup: the nightly job does a catch-up backup a minute after launch.
    protected override void OnInitialized() =>
        _backupStale = Backups.GetStatus().IsStale(DateTimeOffset.UtcNow)
                       && DateTime.Now - System.Diagnostics.Process.GetCurrentProcess().StartTime > TimeSpan.FromHours(1);
    private IJSObjectReference? _hotkeysModule;
    private IJSObjectReference? _hotkeys;
    private DotNetObjectReference<MainLayout>? _self;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#3d5a80",
            AppbarBackground = "#ffffff",
            AppbarText = "#1f2933",
            DrawerBackground = "#f6f7f9",
            Background = "#ffffff",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#8fb3de",
            AppbarBackground = "#1b1d22",
            DrawerBackground = "#1b1d22",
            Background = "#22252b",
            Surface = "#2a2d34",
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "6px" },
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (_themeProvider is not null)
        {
            _dark = await _themeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
        _self = DotNetObjectReference.Create(this);
        _hotkeysModule = await JS.InvokeAsync<IJSObjectReference>("import", "./hotkeys.js");
        _hotkeys = await _hotkeysModule.InvokeAsync<IJSObjectReference>("register", _self);
    }

    [JSInvokable]
    public Task OpenQuickSwitcher() => InvokeAsync(async () =>
    {
        if (_switcherOpen) return;
        _switcherOpen = true;
        try
        {
            var dialog = await Dialogs.ShowAsync<QuickSwitcher>(title: null, new DialogOptions
            {
                MaxWidth = MaxWidth.Small, FullWidth = true, NoHeader = true, Position = DialogPosition.TopCenter,
            });
            await dialog.Result;
        }
        finally
        {
            _switcherOpen = false;
        }
    });

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_hotkeys is not null) { await _hotkeys.InvokeVoidAsync("dispose"); await _hotkeys.DisposeAsync(); }
            if (_hotkeysModule is not null) await _hotkeysModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}
