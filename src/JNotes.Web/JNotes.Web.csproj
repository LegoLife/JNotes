<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\JNotes.Core\JNotes.Core.csproj" />
    <ProjectReference Include="..\JNotes.Data\JNotes.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.1" />
    <PackageReference Include="MudBlazor" Version="9.12.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- Build the Tiptap bundle on first local build (Docker builds it in its own stage). -->
  <Target Name="BuildEditorBundle" BeforeTargets="BeforeBuild" Condition="!Exists('wwwroot/js/editor.js')">
    <Exec Command="npm ci" WorkingDirectory="Editor" />
    <Exec Command="npm run build" WorkingDirectory="Editor" />
  </Target>

</Project>
